# Lumenia sponsor service — environment (testnet sprint)
# Copy to .env for local dev; set these as project env vars when deploying.

STELLAR_NETWORK=testnet
HORIZON_URL=https://horizon-testnet.stellar.org

# Hot sponsor key (Ed25519 S...). Generate + friendbot one with:
#   pnpm --filter @lumenia/sponsor bootstrap
# KMS replaces this later (see src/lib/signer.ts — proven by Spike #1b).
SPONSOR_SECRET=

# The single USDC asset the sponsor opens trustlines to.
USDC_ISSUER=
USDC_CODE=USDC

# OPTIONAL test-USDC faucet key (Ed25519 S...) — a SEPARATE key from the sponsor
# (two blast radii). Unset = POST /faucet is disabled (503). Bootstrap one with:
#   USDC_ISSUER_SECRET=S... pnpm --filter @lumenia/sponsor faucet-bootstrap
FAUCET_SECRET=

# Economic guards
FEE_BUMP_MAX_STROOPS=10000
RATE_CAP=30
RATE_WINDOW_MS=60000
ACCOUNT_RATE_CAP=5
ACCOUNT_RATE_WINDOW_MS=60000

# OPTIONAL durable cross-instance rate limit (serverless): set the Upstash Redis /
# Vercel KV REST pair and bursts 429 across instances. Unset = in-memory buckets.
#   KV_REST_API_URL=            (or UPSTASH_REDIS_REST_URL)
#   KV_REST_API_TOKEN=          (or UPSTASH_REDIS_REST_TOKEN)

# OPTIONAL feedback email notification (POST /feedback → owner's inbox via
# Resend). Unset = reports are only stored/logged, never emailed. Until a domain
# is verified in Resend, delivery works only to the Resend ACCOUNT owner's own
# address — sign up with the address you put in FEEDBACK_NOTIFY_TO.
#   RESEND_API_KEY=
#   FEEDBACK_NOTIFY_TO=

# CORS: the web origin allowed to call this service from the browser.
ALLOWED_ORIGIN=https://lumenia.vercel.app

# This service's OWN public origin. The owner's one-tap pilot approve/decline links are built
# from it. It must be configuration and never the incoming request's Host header, or any hostname
# routed to this Worker could become the link the owner taps. Set on the deployed Workers via
# wrangler.toml [vars]; only needed locally if you are exercising the pilot-request flow.
SPONSOR_ORIGIN=http://localhost:8787

# Smallest escrow the sponsor will facilitate. Its cost per escrow is a fixed ~1 XLM reserve that
# does not scale with the amount, so without a floor a dust send costs full price for nothing.
MIN_DROP_USDC=0.01

# LOCAL DEV ONLY. Recovery normally REFUSES to run without a real mailer, because a deployment
# missing RESEND_API_KEY used to print every recovery code into the logs while still issuing it.
# Set this to 1 on your own machine to get the code printed to the console instead.
#   RECOVERY_ALLOW_MEMORY_STORE=1

PORT=8787
