# Copy to .env (gitignored) inside apps/agent-market. `pnpm --filter @lumenia/agent-market worker` (and `once`,
# `reclaim`) loads it through node --env-file-if-exists. Nothing here is needed for `pnpm test`, `build` or `dry-run`.
# The maintainer's own setup keeps the token in ~/.lumenia-near/agent-market.env (0600) and exports the rest from
# ~/.lumenia-near/run-agent-market.sh (see ops/launchd/README.md); this file is the same list for a .env user.

# --- NEAR Agent Market -------------------------------------------------------
# The agent API token from the listing's Edit page (shown once). Starts with aat_.
AGENT_MARKET_TOKEN=aat_replace_me
# AGENT_MARKET_BASE_URL=https://market.near.ai
# Poll interval in seconds (the market asks for 30 to 60).
# POLL_INTERVAL_S=45

# --- Lumenia NEAR library (@lumenia/near in packages/near; the same variables apps/web/lib/agent-mcp.ts passes it) ---
NEAR_NETWORK=testnet
NEAR_RPC_URL=https://test.rpc.fastnear.com
LUMENIA_CONTRACT_ID=lumenia-near.testnet
USDC_CONTRACT_ID=3e2210e1184b45b64c8a434c0a7e7b23cc04ea7eb7a6c3c32520d03d4afcb8af
FUNDER_ACCOUNT_ID=lumenia-funder.testnet
# One of the two. The file is the near-cli legacy keychain JSON ({"private_key":"ed25519:..."}); read at signing time, never written.
# FUNDER_PRIVATE_KEY=ed25519:...
# FUNDER_KEY_FILE=/Users/you/.near-credentials/testnet/lumenia-funder.testnet.json
# Origin of the claim links: every link is <WEB_ORIGIN>/c/near#<secret>, the NEAR claim screen in apps/web.
WEB_ORIGIN=https://getlumenia.com
DAILY_BUDGET_USDC=50
MAX_LINK_USDC=20
# Receipts + the rolling daily budget live in $LUMENIA_DATA_DIR/links.json. The maintainer gives the worker its own
# directory so it never writes the MCP server's receipt log at the same moment (one writer per file).
LUMENIA_DATA_DIR=~/.lumenia-near/mcp-data

# --- Worker -----------------------------------------------------------------
# Handled assignments, link records and reclaim log (restart-safe).
# STATE_FILE=~/.lumenia-near/agent-market-state.json
# Job limits (the listing promises 1..10 payouts of 0.10..20.00 USDC, expiry 1..168 h, default 72).
# MAX_PAYOUTS_PER_JOB=10
# MIN_PAYOUT_USDC=0.10
# MAX_PAYOUT_USDC=20
# DEFAULT_EXPIRES_HOURS=72
# How often the loop looks for expired links to take back (seconds).
# RECLAIM_EVERY_S=3600
