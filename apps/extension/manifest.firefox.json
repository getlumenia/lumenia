{
  "manifest_version": 3,
  "name": "Lumenia: send dollars by link",
  "short_name": "Lumenia",
  "description": "Send dollars to anyone by link. They tap, they get it, no app, no wallet, and they pay no gas.",
  "version": "0.0.0",
  "homepage_url": "https://getlumenia.com",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Lumenia",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "scripts": ["background.js"]
  },
  "permissions": ["storage", "alarms", "contextMenus", "activeTab", "scripting"],
  "host_permissions": [
    "https://lumenia-sponsor.avakit.workers.dev/*",
    "https://lumenia-sponsor-mainnet.avakit.workers.dev/*",
    "https://horizon-testnet.stellar.org/*",
    "https://horizon.stellar.org/*",
    "https://soroban-testnet.stellar.org/*",
    "https://mainnet.sorobanrpc.com/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; connect-src 'self' https://lumenia-sponsor.avakit.workers.dev https://lumenia-sponsor-mainnet.avakit.workers.dev https://horizon-testnet.stellar.org https://horizon.stellar.org https://soroban-testnet.stellar.org https://mainnet.sorobanrpc.com; img-src 'self'; frame-src 'none'; form-action 'none'; base-uri 'none';"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+L"
      },
      "description": "Open Lumenia"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "extension@getlumenia.com",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["personallyIdentifyingInfo", "authenticationInfo", "financialAndPaymentInfo"],
        "optional": ["technicalAndInteraction"]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  }
}
